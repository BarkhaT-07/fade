# SQLite file used by Prisma. This path is relative to prisma/schema.prisma's
# location conventions — leave as-is unless you know you want to change it.
DATABASE_URL="file:./dev.db"

# 32-byte (64 hex character) key used to encrypt note text with AES-256-GCM.
# Generate one with:
#   openssl rand -hex 32
# Never commit your real key. If you change it, existing notes can no
# longer be decrypted (they'll still expire normally).
NOTE_KEY="replace-with-64-hex-characters-generated-by-openssl-rand-hex-32"
